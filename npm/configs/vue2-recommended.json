{
  "plugins": [
    "vue"
  ],
  "jsPlugins": [
    {
      "name": "vue-rs",
      "specifier": "oxlint-vue-rs"
    }
  ],
  "rules": {
    "vue/component-definition-name-casing": "warn",
    "vue/define-emits-declaration": "off",
    "vue/define-props-declaration": "off",
    "vue/define-props-destructuring": "off",
    "vue/max-props": "off",
    "vue/next-tick-style": "off",
    "vue/no-arrow-functions-in-watch": "error",
    "vue/no-async-in-computed-properties": "error",
    "vue/no-computed-properties-in-data": "error",
    "vue/no-deprecated-data-object-declaration": "off",
    "vue/no-deprecated-delete-set": "off",
    "vue/no-deprecated-destroyed-lifecycle": "off",
    "vue/no-deprecated-events-api": "off",
    "vue/no-deprecated-model-definition": "off",
    "vue/no-deprecated-props-default-this": "off",
    "vue/no-deprecated-vue-config-keycodes": "off",
    "vue/no-dupe-keys": "error",
    "vue/no-export-in-script-setup": "error",
    "vue/no-expose-after-await": "off",
    "vue/no-import-compiler-macros": "off",
    "vue/no-lifecycle-after-await": "off",
    "vue/no-multiple-slot-args": "warn",
    "vue/no-required-prop-with-default": "warn",
    "vue/no-reserved-component-names": "error",
    "vue/no-reserved-keys": "error",
    "vue/no-reserved-props": [
      "error",
      {
        "vueVersion": 2
      }
    ],
    "vue/no-shared-component-data": "error",
    "vue/no-side-effects-in-computed-properties": "error",
    "vue/no-this-in-before-route-enter": "off",
    "vue/no-watch-after-await": "off",
    "vue/prefer-import-from-vue": "off",
    "vue/prop-name-casing": "warn",
    "vue/require-default-export": "off",
    "vue/require-default-prop": "warn",
    "vue/require-direct-export": "off",
    "vue/require-prop-type-constructor": "error",
    "vue/require-prop-types": "warn",
    "vue/require-render-return": "error",
    "vue/require-slots-as-functions": "off",
    "vue/require-typed-ref": "off",
    "vue/return-in-computed-property": "error",
    "vue/return-in-emits-validator": "error",
    "vue/valid-define-emits": "error",
    "vue/valid-define-options": "off",
    "vue/valid-define-props": "error",
    "vue/valid-next-tick": "error",
    "vue-rs/attribute-hyphenation": "warn",
    "vue-rs/attributes-order": "warn",
    "vue-rs/block-order": "warn",
    "vue-rs/comment-directive": "error",
    "vue-rs/first-attribute-linebreak": "warn",
    "vue-rs/html-closing-bracket-newline": "warn",
    "vue-rs/html-closing-bracket-spacing": "warn",
    "vue-rs/html-end-tags": "warn",
    "vue-rs/html-indent": "warn",
    "vue-rs/html-quotes": "warn",
    "vue-rs/html-self-closing": "warn",
    "vue-rs/jsx-uses-vars": "error",
    "vue-rs/max-attributes-per-line": "warn",
    "vue-rs/multi-word-component-names": "error",
    "vue-rs/multiline-html-element-content-newline": "warn",
    "vue-rs/mustache-interpolation-spacing": "warn",
    "vue-rs/no-child-content": "error",
    "vue-rs/no-custom-modifiers-on-v-model": "error",
    "vue-rs/no-dupe-v-else-if": "error",
    "vue-rs/no-duplicate-attributes": "error",
    "vue-rs/no-lone-template": "warn",
    "vue-rs/no-multi-spaces": "warn",
    "vue-rs/no-multiple-template-root": "error",
    "vue-rs/no-mutating-props": "error",
    "vue-rs/no-parsing-error": "error",
    "vue-rs/no-ref-as-operand": "error",
    "vue-rs/no-spaces-around-equal-signs-in-attribute": "warn",
    "vue-rs/no-template-key": "error",
    "vue-rs/no-template-shadow": "warn",
    "vue-rs/no-textarea-mustache": "error",
    "vue-rs/no-unused-components": "error",
    "vue-rs/no-unused-vars": "error",
    "vue-rs/no-use-computed-property-like-method": "error",
    "vue-rs/no-use-v-if-with-v-for": "error",
    "vue-rs/no-useless-template-attributes": "error",
    "vue-rs/no-v-for-template-key": "error",
    "vue-rs/no-v-html": "warn",
    "vue-rs/no-v-model-argument": "error",
    "vue-rs/no-v-text-v-html-on-component": "error",
    "vue-rs/one-component-per-file": "warn",
    "vue-rs/order-in-components": "warn",
    "vue-rs/require-component-is": "error",
    "vue-rs/require-v-for-key": "error",
    "vue-rs/require-valid-default-prop": "error",
    "vue-rs/singleline-html-element-content-newline": "warn",
    "vue-rs/this-in-template": "warn",
    "vue-rs/use-v-on-exact": "error",
    "vue-rs/v-bind-style": "warn",
    "vue-rs/v-on-style": "warn",
    "vue-rs/v-slot-style": "warn",
    "vue-rs/valid-attribute-name": "error",
    "vue-rs/valid-model-definition": "error",
    "vue-rs/valid-template-root": "error",
    "vue-rs/valid-v-bind": "error",
    "vue-rs/valid-v-bind-sync": "error",
    "vue-rs/valid-v-cloak": "error",
    "vue-rs/valid-v-else": "error",
    "vue-rs/valid-v-else-if": "error",
    "vue-rs/valid-v-for": "error",
    "vue-rs/valid-v-html": "error",
    "vue-rs/valid-v-if": "error",
    "vue-rs/valid-v-model": "error",
    "vue-rs/valid-v-on": "error",
    "vue-rs/valid-v-once": "error",
    "vue-rs/valid-v-pre": "error",
    "vue-rs/valid-v-show": "error",
    "vue-rs/valid-v-slot": "error",
    "vue-rs/valid-v-text": "error"
  }
}
